+//////
+//
+// xml_compat.cpp — pugixml-backed implementation of the xmlParser API
+//
+//////
+
+#include "xml_compat.h"
+#include <fstream>
+#include <algorithm>
+#include <cstring>
+#include <iostream>
+
+// ─── Static members ──────────────────────────────────────────────────────────
+
+XMLNode XMLNode::emptyXMLNode;
+XMLClear XMLNode::emptyXMLClear = {NULL, NULL, NULL};
+XMLAttribute XMLNode::emptyXMLAttribute = {NULL, NULL};
+thread_local XMLAttribute XMLNode::s_attr_storage = {NULL, NULL};
+thread_local XMLClear XMLNode::s_clear_storage = {NULL, NULL, NULL};
+thread_local std::string XMLNode::s_clear_value_storage;
+
+// ─── Free functions ──────────────────────────────────────────────────────────
+
+XMLSTR stringDup(XMLCSTR source, int cbData) {
+    if (!source) return NULL;
+    size_t len = (cbData >= 0) ? (size_t)cbData : strlen(source);
+    char* dup = (char*)malloc(len + 1);
+    if (dup) {
+        memcpy(dup, source, len);
+        dup[len] = '\0';
+    }
+    return dup;
+}
+
+void freeXMLString(XMLSTR t) {
+    if (t) free(t);
+}
+
+// ─── Constructors ────────────────────────────────────────────────────────────
+
+XMLNode::XMLNode() : doc_(nullptr), node_() {}
+
+XMLNode::XMLNode(std::shared_ptr<pugi::xml_document> doc, pugi::xml_node node)
+    : doc_(doc), node_(node) {}
+
+// ─── Parsing ─────────────────────────────────────────────────────────────────
+
+static void computeLineCol(const char* xml, ptrdiff_t offset, int& line, int& col) {
+    line = 1;
+    col = 1;
+    for (ptrdiff_t i = 0; i < offset && xml[i]; i++) {
+        if (xml[i] == '\n') {
+            line++;
+            col = 1;
+        } else {
+            col++;
+        }
+    }
+}
+
+XMLNode XMLNode::parseString(XMLCSTR lpXMLString, XMLCSTR tag, XMLResults* pResults) {
+    if (pResults) {
+        pResults->error = eXMLErrorNone;
+        pResults->nLine = 0;
+        pResults->nColumn = 0;
+    }
+
+    if (!lpXMLString || !*lpXMLString) {
+        if (pResults) pResults->error = eXMLErrorEmpty;
+        return emptyXMLNode;
+    }
+
+    auto doc = std::make_shared<pugi::xml_document>();
+    pugi::xml_parse_result result = doc->load_string(lpXMLString,
+        pugi::parse_default | pugi::parse_declaration);
+
+    if (!result) {
+        if (pResults) {
+            // Map pugixml status to xmlParser error codes
+            switch (result.status) {
+                case pugi::status_file_not_found:
+                    pResults->error = eXMLErrorFileNotFound; break;
+                case pugi::status_no_document_element:
+                    pResults->error = eXMLErrorNoElements; break;
+                case pugi::status_end_element_mismatch:
+                    pResults->error = eXMLErrorUnmatchedEndTag; break;
+                case pugi::status_unrecognized_tag:
+                    pResults->error = eXMLErrorMissingTagName; break;
+                default:
+                    pResults->error = eXMLErrorMissingEndTag; break;
+            }
+            computeLineCol(lpXMLString, result.offset, pResults->nLine, pResults->nColumn);
+        }
+        return emptyXMLNode;
+    }
+
+    if (tag) {
+        pugi::xml_node child = doc->child(tag);
+        if (child.empty()) {
+            if (pResults) pResults->error = eXMLErrorFirstTagNotFound;
+            return emptyXMLNode;
+        }
+        return XMLNode(doc, child);
+    }
+
+    // No tag filter — return the document element (first element child)
+    pugi::xml_node first = doc->first_child();
+    // Skip declaration nodes
+    while (!first.empty() && first.type() == pugi::node_declaration)
+        first = first.next_sibling();
+    if (first.empty()) {
+        if (pResults) pResults->error = eXMLErrorNoXMLTagFound;
+        return emptyXMLNode;
+    }
+    return XMLNode(doc, first);
+}
+
+XMLNode XMLNode::parseFile(XMLCSTR filename, XMLCSTR tag, XMLResults* pResults) {
+    if (pResults) {
+        pResults->error = eXMLErrorNone;
+        pResults->nLine = 0;
+        pResults->nColumn = 0;
+    }
+    if (!filename) {
+        if (pResults) pResults->error = eXMLErrorFileNotFound;
+        return emptyXMLNode;
+    }
+
+    // Read entire file into string, then use parseString for consistent behavior
+    std::ifstream ifs(filename, std::ios::binary);
+    if (!ifs.is_open()) {
+        if (pResults) pResults->error = eXMLErrorFileNotFound;
+        return emptyXMLNode;
+    }
+    std::string content((std::istreambuf_iterator<char>(ifs)),
+                        std::istreambuf_iterator<char>());
+    return parseString(content.c_str(), tag, pResults);
+}
+
+XMLNode XMLNode::openFileHelper(XMLCSTR filename, XMLCSTR tag) {
+    XMLResults results;
+    XMLNode node = parseFile(filename, tag, &results);
+    if (results.error != eXMLErrorNone) {
+        std::cerr << "Error parsing XML file '" << (filename ? filename : "(null)")
+                  << "': " << getError(results.error)
+                  << " at line " << results.nLine << " col " << results.nColumn << std::endl;
+        exit(255);
+    }
+    return node;
+}
+
+// ─── Error strings ───────────────────────────────────────────────────────────
+
+XMLCSTR XMLNode::getError(XMLError error) {
+    switch (error) {
+        case eXMLErrorNone:                     return "No error";
+        case eXMLErrorMissingEndTag:            return "Missing end tag";
+        case eXMLErrorNoXMLTagFound:            return "No XML tag found";
+        case eXMLErrorEmpty:                    return "XML string is empty";
+        case eXMLErrorMissingTagName:           return "Missing tag name";
+        case eXMLErrorMissingEndTagName:        return "Missing end tag name";
+        case eXMLErrorUnmatchedEndTag:          return "Unmatched end tag";
+        case eXMLErrorUnmatchedEndClearTag:     return "Unmatched clear end tag";
+        case eXMLErrorUnexpectedToken:          return "Unexpected token";
+        case eXMLErrorNoElements:               return "No elements found";
+        case eXMLErrorFileNotFound:             return "File not found";
+        case eXMLErrorFirstTagNotFound:         return "First tag not found";
+        case eXMLErrorUnknownCharacterEntity:   return "Unknown character entity";
+        case eXMLErrorCharacterCodeAbove255:    return "Character code above 255";
+        case eXMLErrorCharConversionError:      return "Character conversion error";
+        case eXMLErrorCannotOpenWriteFile:      return "Cannot open file for writing";
+        case eXMLErrorCannotWriteFile:          return "Cannot write to file";
+        default:                                return "Unknown error";
+    }
+}
+
+// ─── Serialization ───────────────────────────────────────────────────────────
+
+XMLSTR XMLNode::createXMLString(int nFormat, int* pnSize) const {
+    if (!doc_ || node_.empty()) {
+        if (pnSize) *pnSize = 0;
+        return NULL;
+    }
+
+    std::ostringstream oss;
+    unsigned int flags = pugi::format_raw;
+    if (nFormat) flags = pugi::format_indent;
+
+    node_.print(oss, "\t", flags, pugi::encoding_utf8);
+
+    std::string str = oss.str();
+    if (pnSize) *pnSize = (int)str.size();
+
+    XMLSTR result = (XMLSTR)malloc(str.size() + 1);
+    if (result) {
+        memcpy(result, str.c_str(), str.size() + 1);
+    }
+    return result;
+}
+
+XMLError XMLNode::writeToFile(XMLCSTR filename, const char* encoding, char nFormat) const {
+    if (!filename) return eXMLErrorCannotOpenWriteFile;
+    if (!doc_ || node_.empty()) return eXMLErrorCannotWriteFile;
+
+    unsigned int flags = pugi::format_raw;
+    if (nFormat) flags = pugi::format_indent;
+
+    // If this node IS the document root element, save the whole document
+    // Otherwise save just this node
+    bool saved = false;
+    if (node_ == doc_->document_element()) {
+        saved = doc_->save_file(filename, "\t", flags, pugi::encoding_utf8);
+    } else {
+        std::ofstream ofs(filename, std::ios::binary);
+        if (!ofs.is_open()) return eXMLErrorCannotOpenWriteFile;
+        node_.print(ofs, "\t", flags, pugi::encoding_utf8);
+        saved = ofs.good();
+    }
+    return saved ? eXMLErrorNone : eXMLErrorCannotWriteFile;
+}
+
+// ─── Navigation ──────────────────────────────────────────────────────────────
+
+XMLCSTR XMLNode::getName() const {
+    if (node_.empty()) return NULL;
+    return node_.name();
+}
+
+XMLCSTR XMLNode::getText(int i) const {
+    if (node_.empty()) return NULL;
+    auto texts = textChildren();
+    if (i < 0 || i >= (int)texts.size()) return NULL;
+    return texts[i].value();
+}
+
+int XMLNode::nText() const {
+    if (node_.empty()) return 0;
+    return (int)textChildren().size();
+}
+
+std::vector<pugi::xml_node> XMLNode::textChildren() const {
+    std::vector<pugi::xml_node> result;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_pcdata || child.type() == pugi::node_cdata) {
+            result.push_back(child);
+        }
+    }
+    return result;
+}
+
+std::vector<pugi::xml_node> XMLNode::clearChildren() const {
+    std::vector<pugi::xml_node> result;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_comment || child.type() == pugi::node_pi) {
+            result.push_back(child);
+        }
+    }
+    return result;
+}
+
+XMLNode XMLNode::getParentNode() const {
+    if (node_.empty()) return emptyXMLNode;
+    pugi::xml_node parent = node_.parent();
+    if (parent.empty() || parent.type() == pugi::node_document) return emptyXMLNode;
+    return XMLNode(doc_, parent);
+}
+
+XMLNode XMLNode::getChildNode(int i) const {
+    if (node_.empty()) return emptyXMLNode;
+    int idx = 0;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_element) {
+            if (idx == i) return XMLNode(doc_, child);
+            idx++;
+        }
+    }
+    return emptyXMLNode;
+}
+
+XMLNode XMLNode::getChildNode(XMLCSTR name, int i) const {
+    if (node_.empty() || !name) return emptyXMLNode;
+    if (i == -1) {
+        // Return last child with this name
+        pugi::xml_node last;
+        for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+            if (child.type() == pugi::node_element && strcmp(child.name(), name) == 0)
+                last = child;
+        }
+        return last.empty() ? emptyXMLNode : XMLNode(doc_, last);
+    }
+    int idx = 0;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_element && strcmp(child.name(), name) == 0) {
+            if (idx == i) return XMLNode(doc_, child);
+            idx++;
+        }
+    }
+    return emptyXMLNode;
+}
+
+XMLNode XMLNode::getChildNode(XMLCSTR name, int* i) const {
+    if (node_.empty()) return emptyXMLNode;
+    if (!name) {
+        // No name specified — return first element child (or ith if i provided)
+        int start = i ? *i : 0;
+        int idx = 0;
+        for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+            if (child.type() == pugi::node_element) {
+                if (idx == start) {
+                    if (i) (*i) = idx + 1;
+                    return XMLNode(doc_, child);
+                }
+                idx++;
+            }
+        }
+        return emptyXMLNode;
+    }
+    int start = i ? *i : 0;
+    int idx = 0;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_element && strcmp(child.name(), name) == 0) {
+            if (idx == start) {
+                if (i) (*i) = idx + 1;
+                return XMLNode(doc_, child);
+            }
+            idx++;
+        }
+    }
+    return emptyXMLNode;
+}
+
+XMLNode XMLNode::getChildNodeWithAttribute(XMLCSTR tagName, XMLCSTR attributeName,
+                                            XMLCSTR attributeValue, int* i) const {
+    if (node_.empty() || !tagName || !attributeName) return emptyXMLNode;
+    int start = i ? *i : 0;
+    int idx = 0;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_element && strcmp(child.name(), tagName) == 0) {
+            pugi::xml_attribute attr = child.attribute(attributeName);
+            if (!attr.empty()) {
+                if (!attributeValue || strcmp(attr.value(), attributeValue) == 0) {
+                    if (idx >= start) {
+                        if (i) (*i) = idx + 1;
+                        return XMLNode(doc_, child);
+                    }
+                }
+            }
+            idx++;
+        }
+    }
+    return emptyXMLNode;
+}
+
+int XMLNode::nChildNode(XMLCSTR name) const {
+    if (node_.empty() || !name) return 0;
+    int count = 0;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_element && strcmp(child.name(), name) == 0)
+            count++;
+    }
+    return count;
+}
+
+int XMLNode::nChildNode() const {
+    if (node_.empty()) return 0;
+    int count = 0;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_element)
+            count++;
+    }
+    return count;
+}
+
+XMLAttribute XMLNode::getAttribute(int i) const {
+    if (node_.empty()) return emptyXMLAttribute;
+    int idx = 0;
+    for (auto attr = node_.first_attribute(); attr; attr = attr.next_attribute()) {
+        if (idx == i) {
+            s_attr_storage.lpszName = attr.name();
+            s_attr_storage.lpszValue = attr.value();
+            return s_attr_storage;
+        }
+        idx++;
+    }
+    return emptyXMLAttribute;
+}
+
+XMLCSTR XMLNode::getAttributeName(int i) const {
+    if (node_.empty()) return NULL;
+    int idx = 0;
+    for (auto attr = node_.first_attribute(); attr; attr = attr.next_attribute()) {
+        if (idx == i) return attr.name();
+        idx++;
+    }
+    return NULL;
+}
+
+XMLCSTR XMLNode::getAttributeValue(int i) const {
+    if (node_.empty()) return NULL;
+    int idx = 0;
+    for (auto attr = node_.first_attribute(); attr; attr = attr.next_attribute()) {
+        if (idx == i) return attr.value();
+        idx++;
+    }
+    return NULL;
+}
+
+char XMLNode::isAttributeSet(XMLCSTR name) const {
+    if (node_.empty() || !name) return FALSE;
+    return node_.attribute(name).empty() ? FALSE : TRUE;
+}
+
+XMLCSTR XMLNode::getAttribute(XMLCSTR name, int i) const {
+    if (node_.empty() || !name) return NULL;
+    int idx = 0;
+    for (auto attr = node_.first_attribute(); attr; attr = attr.next_attribute()) {
+        if (strcmp(attr.name(), name) == 0) {
+            if (idx == i) return attr.value();
+            idx++;
+        }
+    }
+    return NULL;
+}
+
+XMLCSTR XMLNode::getAttribute(XMLCSTR name, int* i) const {
+    if (node_.empty() || !name) return NULL;
+    int start = i ? *i : 0;
+    int idx = 0;
+    for (auto attr = node_.first_attribute(); attr; attr = attr.next_attribute()) {
+        if (strcmp(attr.name(), name) == 0) {
+            if (idx >= start) {
+                if (i) (*i) = idx + 1;
+                return attr.value();
+            }
+            idx++;
+        }
+    }
+    return NULL;
+}
+
+int XMLNode::nAttribute() const {
+    if (node_.empty()) return 0;
+    int count = 0;
+    for (auto attr = node_.first_attribute(); attr; attr = attr.next_attribute())
+        count++;
+    return count;
+}
+
+XMLClear XMLNode::getClear(int i) const {
+    if (node_.empty()) return emptyXMLClear;
+    auto clears = clearChildren();
+    if (i < 0 || i >= (int)clears.size()) return emptyXMLClear;
+
+    // Build a string representation like xmlParser does
+    auto& c = clears[i];
+    if (c.type() == pugi::node_comment) {
+        s_clear_value_storage = std::string("<!-- ") + c.value() + " -->";
+        s_clear_storage.lpszValue = s_clear_value_storage.c_str();
+        s_clear_storage.lpszOpenTag = "<!--";
+        s_clear_storage.lpszCloseTag = "-->";
+    } else {
+        s_clear_value_storage = c.value();
+        s_clear_storage.lpszValue = s_clear_value_storage.c_str();
+        s_clear_storage.lpszOpenTag = "<?";
+        s_clear_storage.lpszCloseTag = "?>";
+    }
+    return s_clear_storage;
+}
+
+int XMLNode::nClear() const {
+    if (node_.empty()) return 0;
+    return (int)clearChildren().size();
+}
+
+int XMLNode::nElement() const {
+    return nChildNode() + nText() + nClear() + nAttribute();
+}
+
+char XMLNode::isEmpty() const {
+    return node_.empty() ? TRUE : FALSE;
+}
+
+char XMLNode::isDeclaration() const {
+    return (node_.type() == pugi::node_declaration) ? TRUE : FALSE;
+}
+
+// ─── Deep copy ───────────────────────────────────────────────────────────────
+
+void XMLNode::deepCopyNode(pugi::xml_node dest, pugi::xml_node src) {
+    // Copy attributes
+    for (auto attr = src.first_attribute(); attr; attr = attr.next_attribute()) {
+        dest.append_attribute(attr.name()).set_value(attr.value());
+    }
+    // Copy children (including text, elements, comments, etc.)
+    for (auto child = src.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_element) {
+            auto newChild = dest.append_child(child.name());
+            deepCopyNode(newChild, child);
+        } else if (child.type() == pugi::node_pcdata) {
+            dest.append_child(pugi::node_pcdata).set_value(child.value());
+        } else if (child.type() == pugi::node_cdata) {
+            dest.append_child(pugi::node_cdata).set_value(child.value());
+        } else if (child.type() == pugi::node_comment) {
+            dest.append_child(pugi::node_comment).set_value(child.value());
+        } else if (child.type() == pugi::node_pi) {
+            auto pi = dest.append_child(pugi::node_pi);
+            pi.set_name(child.name());
+            pi.set_value(child.value());
+        }
+    }
+}
+
+XMLNode XMLNode::deepCopy() const {
+    if (node_.empty()) return emptyXMLNode;
+
+    auto newDoc = std::make_shared<pugi::xml_document>();
+    auto newNode = newDoc->append_child(node_.name());
+    deepCopyNode(newNode, node_);
+    return XMLNode(newDoc, newNode);
+}
+
+XMLNode XMLNode::emptyNode() {
+    return emptyXMLNode;
+}
+
+// ─── Creation ────────────────────────────────────────────────────────────────
+
+XMLNode XMLNode::createXMLTopNode(XMLCSTR lpszName, char isDecl) {
+    auto doc = std::make_shared<pugi::xml_document>();
+    pugi::xml_node node;
+    if (isDecl) {
+        node = doc->append_child(pugi::node_declaration);
+    } else {
+        node = doc->append_child(lpszName);
+    }
+    if (isDecl && lpszName) {
+        node.set_name(lpszName);
+    }
+    return XMLNode(doc, node);
+}
+
+XMLNode XMLNode::addChild(XMLCSTR lpszName, char isDecl, XMLElementPosition pos) {
+    if (node_.empty() || !lpszName) return emptyXMLNode;
+
+    pugi::xml_node newChild;
+    if (pos == -1 || pos >= nElement()) {
+        if (isDecl)
+            newChild = node_.append_child(pugi::node_declaration);
+        else
+            newChild = node_.append_child(lpszName);
+        if (isDecl) newChild.set_name(lpszName);
+    } else {
+        // Insert before the element at position pos
+        // Find the child at that position
+        int idx = 0;
+        pugi::xml_node before;
+        for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+            if (child.type() == pugi::node_element) {
+                if (idx == pos) { before = child; break; }
+                idx++;
+            }
+        }
+        if (before.empty()) {
+            newChild = node_.append_child(lpszName);
+        } else {
+            newChild = node_.insert_child_before(lpszName, before);
+        }
+    }
+    return XMLNode(doc_, newChild);
+}
+
+XMLNode XMLNode::addChild(XMLNode nodeToAdd, XMLElementPosition pos) {
+    if (node_.empty() || nodeToAdd.isEmpty()) return emptyXMLNode;
+
+    pugi::xml_node copied;
+    if (pos == -1 || pos >= nElement()) {
+        copied = node_.append_copy(nodeToAdd.node_);
+    } else {
+        int idx = 0;
+        pugi::xml_node before;
+        for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+            if (child.type() == pugi::node_element) {
+                if (idx == pos) { before = child; break; }
+                idx++;
+            }
+        }
+        if (before.empty())
+            copied = node_.append_copy(nodeToAdd.node_);
+        else
+            copied = node_.insert_copy_before(nodeToAdd.node_, before);
+    }
+
+    return XMLNode(doc_, copied);
+}
+
+XMLAttribute* XMLNode::addAttribute(XMLCSTR lpszName, XMLCSTR lpszValue) {
+    if (node_.empty() || !lpszName) return &emptyXMLAttribute;
+    auto attr = node_.append_attribute(lpszName);
+    if (lpszValue) attr.set_value(lpszValue);
+    s_attr_storage.lpszName = attr.name();
+    s_attr_storage.lpszValue = attr.value();
+    return &s_attr_storage;
+}
+
+XMLCSTR XMLNode::addText(XMLCSTR lpszValue, XMLElementPosition pos) {
+    if (node_.empty() || !lpszValue) return NULL;
+    pugi::xml_node text;
+    if (pos == -1) {
+        text = node_.append_child(pugi::node_pcdata);
+    } else {
+        // Find position to insert before
+        int idx = 0;
+        pugi::xml_node before;
+        for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+            if (idx == pos) { before = child; break; }
+            idx++;
+        }
+        if (before.empty())
+            text = node_.append_child(pugi::node_pcdata);
+        else
+            text = node_.insert_child_before(pugi::node_pcdata, before);
+    }
+    text.set_value(lpszValue);
+    return text.value();
+}
+
+// ─── Update ──────────────────────────────────────────────────────────────────
+
+XMLCSTR XMLNode::updateName(XMLCSTR lpszName) {
+    if (node_.empty() || !lpszName) return NULL;
+    node_.set_name(lpszName);
+    return node_.name();
+}
+
+XMLAttribute* XMLNode::updateAttribute(XMLCSTR lpszNewValue, XMLCSTR lpszNewName, int i) {
+    if (node_.empty()) return &emptyXMLAttribute;
+
+    int idx = 0;
+    pugi::xml_attribute attr;
+    for (attr = node_.first_attribute(); attr; attr = attr.next_attribute()) {
+        if (idx == i) break;
+        idx++;
+    }
+
+    if (attr.empty()) {
+        // Attribute doesn't exist at index i — add new
+        return addAttribute(lpszNewName ? lpszNewName : "", lpszNewValue ? lpszNewValue : "");
+    }
+
+    if (lpszNewValue) attr.set_value(lpszNewValue);
+    if (lpszNewName) attr.set_name(lpszNewName);
+
+    s_attr_storage.lpszName = attr.name();
+    s_attr_storage.lpszValue = attr.value();
+    return &s_attr_storage;
+}
+
+XMLAttribute* XMLNode::updateAttribute(XMLCSTR lpszNewValue, XMLCSTR lpszNewName, XMLCSTR lpszOldName) {
+    if (node_.empty()) return &emptyXMLAttribute;
+
+    if (lpszOldName) {
+        pugi::xml_attribute attr = node_.attribute(lpszOldName);
+        if (!attr.empty()) {
+            if (lpszNewValue) attr.set_value(lpszNewValue);
+            if (lpszNewName) attr.set_name(lpszNewName);
+            s_attr_storage.lpszName = attr.name();
+            s_attr_storage.lpszValue = attr.value();
+            return &s_attr_storage;
+        }
+    }
+
+    // Attribute not found — add new
+    const char* name = lpszNewName ? lpszNewName : (lpszOldName ? lpszOldName : "");
+    return addAttribute(name, lpszNewValue ? lpszNewValue : "");
+}
+
+XMLCSTR XMLNode::updateText(XMLCSTR lpszNewValue, int i) {
+    if (node_.empty()) return NULL;
+    auto texts = textChildren();
+    if (i < (int)texts.size()) {
+        texts[i].set_value(lpszNewValue ? lpszNewValue : "");
+        return texts[i].value();
+    }
+    // Text at index i doesn't exist — add new
+    return addText(lpszNewValue ? lpszNewValue : "");
+}
+
+XMLCSTR XMLNode::updateText(XMLCSTR lpszNewValue, XMLCSTR lpszOldValue) {
+    if (node_.empty()) return NULL;
+    auto texts = textChildren();
+    for (auto& t : texts) {
+        if (lpszOldValue && strcmp(t.value(), lpszOldValue) == 0) {
+            t.set_value(lpszNewValue ? lpszNewValue : "");
+            return t.value();
+        }
+    }
+    return addText(lpszNewValue ? lpszNewValue : "");
+}
+
+// ─── Deletion ────────────────────────────────────────────────────────────────
+
+void XMLNode::deleteNodeContent() {
+    if (node_.empty()) return;
+
+    // Remove all children
+    while (node_.first_child())
+        node_.remove_child(node_.first_child());
+
+    // Remove all attributes
+    while (node_.first_attribute())
+        node_.remove_attribute(node_.first_attribute());
+
+    // Remove the node itself from its parent
+    pugi::xml_node parent = node_.parent();
+    if (!parent.empty()) {
+        parent.remove_child(node_);
+    }
+    node_ = pugi::xml_node(); // invalidate
+}
+
+void XMLNode::deleteAttribute(int i) {
+    if (node_.empty()) return;
+    int idx = 0;
+    for (auto attr = node_.first_attribute(); attr; attr = attr.next_attribute()) {
+        if (idx == i) {
+            node_.remove_attribute(attr);
+            return;
+        }
+        idx++;
+    }
+}
+
+void XMLNode::deleteAttribute(XMLCSTR lpszName) {
+    if (node_.empty() || !lpszName) return;
+    pugi::xml_attribute attr = node_.attribute(lpszName);
+    if (!attr.empty()) node_.remove_attribute(attr);
+}
+
+void XMLNode::deleteText(int i) {
+    if (node_.empty()) return;
+    auto texts = textChildren();
+    if (i >= 0 && i < (int)texts.size()) {
+        node_.remove_child(texts[i]);
+    }
+}
+
+void XMLNode::deleteText(XMLCSTR lpszValue) {
+    if (node_.empty()) return;
+    auto texts = textChildren();
+    for (auto& t : texts) {
+        if (lpszValue && strcmp(t.value(), lpszValue) == 0) {
+            node_.remove_child(t);
+            return;
+        }
+    }
+}
+
+// ─── Position helpers ────────────────────────────────────────────────────────
+
+// These return a linear position across all children (elements, text, clear)
+// matching the xmlParser ordering semantics.
+
+XMLElementPosition XMLNode::positionOfText(int i) const {
+    if (node_.empty()) return -1;
+    auto texts = textChildren();
+    if (i < 0 || i >= (int)texts.size()) return -1;
+    pugi::xml_node target = texts[i];
+    int pos = 0;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child == target) return pos;
+        pos++;
+    }
+    return -1;
+}
+
+XMLElementPosition XMLNode::positionOfChildNode(int i) const {
+    if (node_.empty()) return -1;
+    int elemIdx = 0;
+    int pos = 0;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_element) {
+            if (elemIdx == i) return pos;
+            elemIdx++;
+        }
+        pos++;
+    }
+    return -1;
+}
+
+XMLElementPosition XMLNode::positionOfChildNode(XMLNode x) const {
+    if (node_.empty() || x.isEmpty()) return -1;
+    int pos = 0;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child == x.node_) return pos;
+        pos++;
+    }
+    return -1;
+}
+
+XMLElementPosition XMLNode::positionOfChildNode(XMLCSTR name, int i) const {
+    if (!name) return positionOfChildNode(i);
+    if (node_.empty()) return -1;
+    int nameIdx = 0;
+    int pos = 0;
+    for (auto child = node_.first_child(); child; child = child.next_sibling()) {
+        if (child.type() == pugi::node_element && strcmp(child.name(), name) == 0) {
+            if (nameIdx == i) return pos;
+            nameIdx++;
+        }
+        pos++;
+    }
+    return -1;
+}
+
+// ─── Operators ───────────────────────────────────────────────────────────────
+
+bool XMLNode::operator==(const XMLNode& other) const {
+    return node_ == other.node_;
+}
