+void XMLParserBase64Tool::alloc(int newsize) {
+    if (newsize > buflen_) {
+        buf_ = realloc(buf_, newsize);
+        buflen_ = newsize;
+    }
+}
+
+int XMLParserBase64Tool::encodeLength(int inBufLen, char formatted) {
+    int n = ((inBufLen + 2) / 3) * 4;
+    if (formatted) n += (n / 72) + 1; // newline every 72 chars
+    return n + 1; // +1 for null terminator
+}
+
+XMLSTR XMLParserBase64Tool::encode(unsigned char* inByteBuf, unsigned int inByteLen, char formatted) {
+    int outLen = encodeLength(inByteLen, formatted);
+    alloc(outLen);
+    char* out = (char*)buf_;
+    int lineLen = 0;
+    unsigned int i;
+
+    for (i = 0; i + 2 < inByteLen; i += 3) {
+        unsigned int triple = ((unsigned int)inByteBuf[i] << 16) |
+                              ((unsigned int)inByteBuf[i+1] << 8) |
+                              ((unsigned int)inByteBuf[i+2]);
+        *out++ = b64_encode_table[(triple >> 18) & 0x3F];
+        *out++ = b64_encode_table[(triple >> 12) & 0x3F];
+        *out++ = b64_encode_table[(triple >> 6) & 0x3F];
+        *out++ = b64_encode_table[triple & 0x3F];
+        lineLen += 4;
+        if (formatted && lineLen >= 72) { *out++ = '\n'; lineLen = 0; }
+    }
+
+    if (i < inByteLen) {
+        unsigned int a = inByteBuf[i];
+        unsigned int b = (i + 1 < inByteLen) ? inByteBuf[i+1] : 0;
+        unsigned int triple = (a << 16) | (b << 8);
+        *out++ = b64_encode_table[(triple >> 18) & 0x3F];
+        *out++ = b64_encode_table[(triple >> 12) & 0x3F];
+        *out++ = (i + 1 < inByteLen) ? b64_encode_table[(triple >> 6) & 0x3F] : '=';
+        *out++ = '=';
+    }
+
+    if (formatted && lineLen > 0) *out++ = '\n';
+    *out = '\0';
+    return (XMLSTR)buf_;
+}
+
+unsigned int XMLParserBase64Tool::decodeSize(XMLCSTR inString, XMLError* xe) {
+    if (!inString) { if (xe) *xe = eXMLErrorBase64DecodeTruncatedData; return 0; }
+    unsigned int len = 0;
+    for (const char* p = inString; *p; p++) {
+        unsigned char c = (unsigned char)*p;
+        if (c == '=') break;
+        if (b64_decode_table[c] != 255) len++;
+    }
+    if (len % 4 != 0 && len % 4 != 2 && len % 4 != 3) {
+        if (xe) *xe = eXMLErrorBase64DataSizeIsNotMultipleOf4;
+        return 0;
+    }
+    return (len * 3) / 4;
+}
+
+unsigned char* XMLParserBase64Tool::decode(XMLCSTR inString, int* outByteLen, XMLError* xe) {
+    if (xe) *xe = eXMLErrorNone;
+    if (!inString) {
+        if (outByteLen) *outByteLen = 0;
+        if (xe) *xe = eXMLErrorBase64DecodeTruncatedData;
+        return nullptr;
+    }
+
+    // Collect valid base64 chars
+    std::vector<unsigned char> input;
+    int padding = 0;
+    for (const char* p = inString; *p; p++) {
+        unsigned char c = (unsigned char)*p;
+        if (c == '=') { padding++; continue; }
+        if (c == '\n' || c == '\r' || c == ' ' || c == '\t') continue;
+        if (b64_decode_table[c] == 255) {
+            if (xe) *xe = eXMLErrorBase64DecodeIllegalCharacter;
+            if (outByteLen) *outByteLen = 0;
+            return nullptr;
+        }
+        input.push_back(b64_decode_table[c]);
+    }
+
+    if (input.size() % 4 == 1) {
+        if (xe) *xe = eXMLErrorBase64DataSizeIsNotMultipleOf4;
+        if (outByteLen) *outByteLen = 0;
+        return nullptr;
+    }
+
+    // Pad to multiple of 4
+    while (input.size() % 4 != 0) input.push_back(0);
+
+    int outSize = ((int)input.size() / 4) * 3 - padding;
+    alloc(outSize + 1);
+    unsigned char* out = (unsigned char*)buf_;
+    int j = 0;
+
+    for (size_t i = 0; i + 3 < input.size(); i += 4) {
+        unsigned int triple = ((unsigned int)input[i] << 18) |
+                              ((unsigned int)input[i+1] << 12) |
+                              ((unsigned int)input[i+2] << 6) |
+                              ((unsigned int)input[i+3]);
+        if (j < outSize) out[j++] = (triple >> 16) & 0xFF;
+        if (j < outSize) out[j++] = (triple >> 8) & 0xFF;
+        if (j < outSize) out[j++] = triple & 0xFF;
+    }
+
+    if (outByteLen) *outByteLen = outSize;
+    return out;
+}
