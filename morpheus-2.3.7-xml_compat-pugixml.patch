-// Obtain the next character from the string.
-static inline XMLCHAR getNextChar(XML *pXML)
-{
-    XMLCHAR ch = pXML->lpXML[pXML->nIndex];
-#ifdef _XMLWIDECHAR
-    if (ch!=0) pXML->nIndex++;
-#else
-    pXML->nIndex+=XML_ByteTable[(unsigned char)ch];
-#endif
