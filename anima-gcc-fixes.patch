diff --git a/Anima/cmake/AnimaDependencies.cmake b/Anima/cmake/AnimaDependencies.cmake
index bd8fc30..6d997e8 100644
--- a/Anima/cmake/AnimaDependencies.cmake
+++ b/Anima/cmake/AnimaDependencies.cmake
@@ -30,30 +30,32 @@ if(USE_NLOPT)
   find_package(NLOPT REQUIRED)
 endif()
 
-# TinyXML2
-if (BUILD_MODULE_REGISTRATION OR BUILD_MODULE_DIFFUSION)
-	find_package(TinyXML2 REQUIRED)
-endif()
+# TinyXML2 — needed by AnimaDataIO (always built). The BUILD_MODULE_* options are
+# defined later (AnimaModulesSetup), so guarding on them skips the find on a fresh
+# configure and leaves TinyXML2_LIBRARY empty (-> undefined tinyxml2:: symbols in
+# libAnimaDataIO). Find it unconditionally.
+find_package(TinyXML2 REQUIRED)
 
 # VTK
-if (BUILD_MODULE_REGISTRATION OR BUILD_MODULE_DIFFUSION OR BUILD_MODULE_MATHS)
-  option(USE_VTK "Use VTK libraries (necessary for some registration tools and tractography)" OFF)
-
-  if(USE_VTK)
-    find_package(VTK REQUIRED COMPONENTS vtkCommonCore vtkFiltersCore vtkIOXML vtkIOLegacy vtksys QUIET)
+# NB: the BUILD_MODULE_* options are only defined later (AnimaModulesSetup, which
+# in turn needs the include dirs found here), so guarding this block on them skips
+# VTK entirely on a fresh configure and leaves VTK_PREFIX empty (-> bare -lIOXML
+# link failures). USE_VTK is the real control; key it on that alone.
+option(USE_VTK "Use VTK libraries (necessary for some registration tools and tractography)" OFF)
 
-    if (VTK_VERSION_MAJOR LESS 7)
-      message(SEND_ERROR "VTK has to be version 7 or higher.")
-    endif()
+if(USE_VTK)
+  # Modern VTK (>= 9) uses unprefixed component names and namespaced imported
+  # targets (VTK::CommonCore ...). The legacy vtk*-prefixed component spelling
+  # resolves inconsistently on VTK 9.6, so request the modern names and force
+  # the VTK:: prefix unconditionally.
+  find_package(VTK REQUIRED COMPONENTS CommonCore FiltersCore IOXML IOLegacy)
 
-    set(VTK_PREFIX "VTK::")
-    set(VTKSYS_LIBRARY VTK::vtksys)
-    if (VTK_VERSION VERSION_LESS "8.90.0")
-        include(${VTK_USE_FILE})
-        set(VTK_PREFIX "vtk")
-        set(VTKSYS_LIBRARY vtksys)
-    endif()
+  if (VTK_VERSION_MAJOR LESS 7)
+    message(SEND_ERROR "VTK has to be version 7 or higher.")
   endif()
+
+  set(VTK_PREFIX "VTK::")
+  set(VTKSYS_LIBRARY VTK::vtksys)
 endif()
 
