--- a/Anima/diffusion/mcm/animaTensorCompartment.cxx
+++ b/Anima/diffusion/mcm/animaTensorCompartment.cxx
@@ -379,7 +379,13 @@ void TensorCompartment::Reorient(vnl_matrix <double> &orientationMatrix, bool af
         EigVecMatrixType eigVecs;
         EigValVectorType eigVals;
 
-        eigenComputer.ComputeEigenValuesAndVectors(m_WorkVnlMatrix1,eigVals,eigVecs);
+        // ITK 5.4 SymmetricEigenAnalysis requires the matrix type to match the
+        // template arg exactly; copy the 3x3 vnl_matrix into an itk::Matrix.
+        EigVecMatrixType workMatrix;
+        for (unsigned int wi = 0;wi < 3;++wi)
+            for (unsigned int wj = 0;wj < 3;++wj)
+                workMatrix(wi,wj) = m_WorkVnlMatrix1(wi,wj);
+        eigenComputer.ComputeEigenValuesAndVectors(workMatrix,eigVals,eigVecs);
         anima::ExtractPPDRotationFromJacobianMatrix(orientationMatrix,ppdOrientationMatrix,eigVecs);
         anima::RotateSymmetricMatrix(m_WorkVnlMatrix1,ppdOrientationMatrix,m_WorkVnlMatrix2);
     }
