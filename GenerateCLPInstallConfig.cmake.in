# GenerateCLP install-tree config
# Set paths relative to this file's location (lib/GenerateCLP/)
get_filename_component(GenerateCLP_CONFIG_DIR
  "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_prefix "${GenerateCLP_CONFIG_DIR}/../.." ABSOLUTE)

set(GenerateCLP_INCLUDE_DIRS "${_prefix}/include/GenerateCLP")
set(GenerateCLP_LIBRARY_DIRS "${GenerateCLP_CONFIG_DIR}")
set(GenerateCLP_CMAKE_DIR "${GenerateCLP_CONFIG_DIR}")
set(GenerateCLP_USE_FILE "${GenerateCLP_CONFIG_DIR}/UseGenerateCLP.cmake")
set(GenerateCLP_USE_JSONCPP "@GenerateCLP_USE_JSONCPP@")
set(GenerateCLP_USE_SERIALIZER "@GenerateCLP_USE_SERIALIZER@")
set(SlicerExecutionModel_USE_UTF8 "@SlicerExecutionModel_USE_UTF8@")
set(SlicerExecutionModel_CMAKE_DIR "${_prefix}/@SEM_INSTALL_LIB_DIR@/SlicerExecutionModel/CMake")
set(TCLAP_DIR "${_prefix}/@SEM_INSTALL_LIB_DIR@/tclap")
set(ModuleDescriptionParser_DIR "${_prefix}/@SEM_INSTALL_LIB_DIR@/ModuleDescriptionParser")
set(ITK_DIR "@ITK_DIR@")

find_program(GENERATECLP_EXE
  NAMES GenerateCLP GenerateCLPLauncher
  PATHS "${_prefix}/bin"
  NO_DEFAULT_PATH
  )

include("${SlicerExecutionModel_CMAKE_DIR}/SEMFunctionAddExecutable.cmake")
