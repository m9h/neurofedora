#!/usr/bin/env bats
# slicer.bats — real functional tests for the 3D Slicer stack
# (3dslicer + 3dslicer-<extension> packages).
#
# WHY THIS EXISTS: the autogenerated smoke.bats only checks that files exist.
# That cannot catch the failure modes that actually bite a Slicer platform:
#   - the app launches but registers zero modules (broken launcher/cmake);
#   - an extension builds green but installs into a stale Slicer-X.Y version
#     path the launcher never scans, so its module never loads;
#   - a scripted module raises on import and silently drops out of the module
#     list (this is how 3dslicer-spharm-pdm's ShapeAnalysisModule regressed).
# These tests launch the real installed application headless and exercise
# Slicer's OWN regression infrastructure via slicer/slicer_selftest.py.
#
# Run with:
#   bats slicer.bats
#   SLICER_SELFTEST_TIMEOUT=600 bats slicer.bats   # slow box
#
# The headless launch needs offscreen Qt; the wrapper sets QT_QPA_PLATFORM.

bats_require_minimum_version 1.5.0

HERE="${BATS_TEST_DIRNAME}"

setup_file() {
    export NEUROFEDORA_TESTS=1
}

_require_installed() {
    local pkg="$1"
    rpm -q --quiet "$pkg" 2>/dev/null || skip "$pkg not installed"
}

# Slicer version tag derived from the installed RPM — never hardcoded.
_slicer_tag() {
    rpm -ql 3dslicer 2>/dev/null | grep -oE 'Slicer-[0-9]+\.[0-9]+' | head -1
}

# ── install-level smoke ─────────────────────────────────────────────────────

@test "3dslicer: launcher and version path installed" {
    _require_installed 3dslicer
    [ -x /usr/bin/Slicer ]
    local tag; tag="$(_slicer_tag)"
    [ -n "$tag" ]
    [ -d "/usr/lib/slicer/lib/${tag}/qt-loadable-modules" ]
    [ -d "/usr/lib/slicer/lib/${tag}/cli-modules" ]
}

@test "3dslicer-devel: generated SlicerConfig.cmake present for extension builds" {
    _require_installed 3dslicer-devel
    local tag; tag="$(_slicer_tag)"
    # find_package(Slicer) consumes the GENERATED config at the lib/<tag> root
    # (the CMake/ subdir holds the .in templates and macro helpers).
    [ -f "/usr/lib/slicer/lib/${tag}/SlicerConfig.cmake" ]
    [ -f "/usr/lib/slicer/lib/${tag}/UseSlicer.cmake" ]
    [ -f "/usr/lib/slicer/lib/${tag}/CMake/UseSlicerMacros.cmake" ]
}

# Each packaged extension must drop its module into the CURRENT version's tree,
# not a stale one. This is a cheap path-level guard that complements the live
# module-registration check below.
@test "extensions: installed under the current Slicer version tree (no stale X.Y path)" {
    _require_installed 3dslicer
    local tag; tag="$(_slicer_tag)"
    local bad=0 p
    for p in $(rpm -qa | grep -E '^3dslicer-' | grep -vE 'devel$'); do
        # any Slicer-X.Y dir owned by the ext that isn't the current tag = stale
        if rpm -ql "$p" | grep -oE 'Slicer-[0-9]+\.[0-9]+' | grep -qvF "$tag"; then
            echo "STALE PATH: $p ships files under a non-$tag Slicer tree" >&3
            rpm -ql "$p" | grep -oE 'Slicer-[0-9]+\.[0-9]+' | sort -u >&3
            bad=1
        fi
    done
    [ "$bad" -eq 0 ]
}

# ── headless regression run (Slicer's own self-test infrastructure) ─────────

@test "3dslicer: headless self-test driver passes (identity, MRML, CLI, extension modules)" {
    _require_installed 3dslicer
    run "${HERE}/slicer/run-slicer-selftest.sh"
    # Echo the driver output so failures are legible in TAP.
    echo "$output" >&3
    if [ "$status" -eq 77 ]; then skip "3dslicer not installed"; fi
    [ "$status" -eq 0 ]
    # Belt-and-suspenders: the driver prints an explicit verdict line.
    echo "$output" | grep -qE '^\[SLICER-SELFTEST\] PASS'
}
