#!/usr/bin/env bats
# AUTOGENERATED from pipelines.tsv by generate-pipelines.sh — do not edit manually.
#
# Each test gets a per-test $TMP (auto-cleaned) and inherits $FIX pointing at
# the synthesized fixtures dir. Skips cleanly when fixtures or the package
# under test are missing — never produces a false failure for an absent dep.

bats_require_minimum_version 1.5.0

HERE="$(dirname "${BATS_TEST_FILENAME}")"
export FIX="${HERE}/fixtures"

setup_file() {
    export NEUROFEDORA_TESTS=1
    if [[ ! -f "$FIX/t1.nii.gz" ]]; then
        if [[ -x "$FIX/generate-fixtures.sh" ]]; then
            "$FIX/generate-fixtures.sh" >&2 || true
        fi
    fi
}

setup()    { export TMP="$(mktemp -d -t neurofedora-pipe.XXXXXX)"; }
teardown() { [[ -n "${TMP:-}" && -d "$TMP" ]] && rm -rf "$TMP"; }

_require_installed() {
    rpm -q --quiet "$1" 2>/dev/null || skip "$1 not installed"
}

_require_fixtures() {
    [[ -f "$FIX/t1.nii.gz" ]] \
        || skip "fixtures missing (run fixtures/generate-fixtures.sh)"
}

# Real-world fixture set — MRI (MNI152), robotics URDFs, MorpheusML
# examples, BED genomics samples — all fetched by fetch-real-fixtures.sh.
# Accepts an optional path argument so each test can guard on its own
# specific file (the fetcher's sections are independent; one may have
# succeeded while another failed offline).
_require_real_fixtures() {
    local file="${1:-$FIX/real/mni152_t1_2mm.nii.gz}"
    [[ -f "$file" ]] \
        || skip "real fixture missing: $file (run fixtures/fetch-real-fixtures.sh)"
}


@test "[001] dcmtk: dcmdump \"$FIX/dicom/slice_000.dcm\"" {
    _require_fixtures
    _require_installed "dcmtk"
    run --separate-stderr bash <<'PIPECMD'
dcmdump "$FIX/dicom/slice_000.dcm"
PIPECMD
    if [ "$status" -ne 0 ]; then
        echo "command failed (exit=$status)"
        echo "stdout: $output"
        echo "stderr: $stderr"
        false
    fi
    if ! grep -qE "NEUROFEDORA-TEST.*PatientID" <<<"$output $stderr"; then
        echo "expected /NEUROFEDORA-TEST.*PatientID/ in output, got:"
        echo "stdout: $output"
        echo "stderr: $stderr"
        false
    fi
}

