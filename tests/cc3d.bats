#!/usr/bin/env bats
# cc3d.bats — real functional tests for the CompuCell3D stack
# (compucell3d / python3-compucell3d / cc3d-player5 / cc3d-twedit5).
#
# WHY THIS EXISTS: the autogenerated smoke.bats only checks that files/binaries
# exist (e.g. `test -x /usr/bin/cc3d_runScript.sh`). That cannot catch a missing
# runtime dependency or a broken import — e.g. cc3d-twedit5 launching straight
# into `ModuleNotFoundError: No module named 'chardet'`, or the engine failing
# to load its steppable libs (RPATH), or the wizard plugin importing the
# removed-in-3.14 distutils. These tests import and launch the real code paths
# so those regressions fail loudly.
#
# Run with:
#   bats cc3d.bats
#   bats --jobs 4 cc3d.bats
#   NEUROFEDORA_GUI_BACKEND=xvfb bats cc3d.bats   # enable GUI launch tests

bats_require_minimum_version 1.5.0

DEMOS_ROOT="/usr/share/compucell3d/Demos"
ANGIO="${DEMOS_ROOT}/BookChapterDemos_ComputationalMethodsInCellBiology/Angiogenesis"

setup_file() {
    export NEUROFEDORA_TESTS=1
}

_require_installed() {
    local pkg="$1"
    rpm -q --quiet "$pkg" 2>/dev/null || skip "$pkg not installed"
}

_require_xvfb() {
    command -v xvfb-run >/dev/null \
        || skip "xvfb-run not installed (dnf install xorg-x11-server-Xvfb)"
}

# A Python import smoke test: run `python3 -c "<expr>"` and FAIL on any
# traceback. This is the cheap test class that catches missing deps.
_py_import() {
    run --separate-stderr python3 -c "$1"
    [ "$status" -eq 0 ] || { echo "import failed: $1"; echo "stdout=$output"; echo "stderr=$stderr"; false; }
}

# ---------------------------------------------------------------------------
# Binaries present
# ---------------------------------------------------------------------------

@test "compucell3d (cli): cc3d_runScript.sh is executable and uses python3" {
    _require_installed "compucell3d"
    run --separate-stderr bash -c "test -x /usr/bin/cc3d_runScript.sh && grep -q 'PYTHON_EXEC=python3' /usr/bin/cc3d_runScript.sh"
    [ "$status" -eq 0 ] || { echo "cc3d_runScript.sh missing or still calls bare 'python': $output $stderr"; false; }
}

@test "cc3d-player5 (cli): /usr/bin/cc3d-player5 present" {
    _require_installed "cc3d-player5"
    run --separate-stderr bash -c "test -x /usr/bin/cc3d-player5"
    [ "$status" -eq 0 ] || { echo "$output $stderr"; false; }
}

@test "cc3d-player5 (cli): cc3d-demo helper present" {
    _require_installed "cc3d-player5"
    run --separate-stderr bash -c "test -x /usr/bin/cc3d-demo"
    [ "$status" -eq 0 ] || { echo "$output $stderr"; false; }
}

@test "cc3d-twedit5 (cli): /usr/bin/cc3d-twedit5 present" {
    _require_installed "cc3d-twedit5"
    run --separate-stderr bash -c "test -x /usr/bin/cc3d-twedit5"
    [ "$status" -eq 0 ] || { echo "$output $stderr"; false; }
}

# ---------------------------------------------------------------------------
# Python import smoke — these catch the missing-dependency / bad-import bugs
# ---------------------------------------------------------------------------

@test "python3-compucell3d (import): cc3d.cpp.CompuCell loads (RPATH/steppable libs)" {
    _require_installed "python3-compucell3d"
    # Fails if the SWIG module can't load its plugin/steppable .so deps
    # (i.e. the $ORIGIN RPATHs into cc3d/cpp/ are missing).
    _py_import "import cc3d.cpp.CompuCell"
}

@test "python3-compucell3d (import): cc3d engine entrypoint imports (lxml/scipy/...)" {
    _require_installed "python3-compucell3d"
    _py_import "import cc3d.CompuCellSetup"
}

@test "cc3d-player5 (import): UI.UserInterface imports (catches missing anyio)" {
    _require_installed "cc3d-player5"
    _py_import "import cc3d.player5.UI.UserInterface"
}

@test "cc3d-player5 (import): web-fetch util imports (catches missing requests)" {
    _require_installed "cc3d-player5"
    _py_import "import cc3d.player5.Utilities.WebFetcherRequests"
}

@test "cc3d-twedit5 (import): global_imports loads (catches missing chardet + QScintilla)" {
    _require_installed "cc3d-twedit5"
    # This is the exact chain that threw 'No module named chardet' on launch,
    # and that also pulls 'from PyQt5.Qsci import *'.
    _py_import "import cc3d.twedit5.twedit.utils.global_imports"
}

@test "cc3d-twedit5 (import): QScintilla (PyQt5.Qsci) available" {
    _require_installed "cc3d-twedit5"
    _py_import "from PyQt5.Qsci import QsciScintilla"
}

@test "cc3d-twedit5 (import): New Simulation Wizard plugin loads (catches distutils removal)" {
    _require_installed "cc3d-twedit5"
    # PluginCCDProject imported distutils, removed in Python 3.14 -> wizard dead.
    _py_import "import cc3d.twedit5.Plugins.PluginCCDProject"
}

@test "cc3d-twedit5 (import): ALL Plugins import (catches any plugin load error)" {
    _require_installed "cc3d-twedit5"
    # Import every module under cc3d.twedit5.Plugins and fail listing any that
    # raise. This is what catches plugins Twedit would silently drop with
    # "plugins have errors and will not be loaded" (e.g. PluginCCDPythonHelper
    # importing the unpackaged QtWebKit binding).
    run --separate-stderr python3 -c '
import importlib, pkgutil, sys
import cc3d.twedit5.Plugins as P
fails = []
for m in pkgutil.iter_modules(P.__path__):
    try:
        importlib.import_module("cc3d.twedit5.Plugins." + m.name)
    except Exception as e:
        fails.append("%s: %s: %s" % (m.name, type(e).__name__, e))
if fails:
    print("\n".join(fails)); sys.exit(1)
print("all plugins import OK")
'
    [ "$status" -eq 0 ] || { echo "plugin import failures:"; echo "$output"; echo "$stderr"; false; }
}

# ---------------------------------------------------------------------------
# Bundled demos + helper
# ---------------------------------------------------------------------------

@test "python3-compucell3d (data): Angiogenesis demo installed" {
    _require_installed "python3-compucell3d"
    run --separate-stderr bash -c "test -f '${ANGIO}/Angiogenesis.cc3d'"
    [ "$status" -eq 0 ] || { echo "Angiogenesis demo missing under ${DEMOS_ROOT}: $output $stderr"; false; }
}

@test "cc3d-player5 (cli): cc3d-demo --list finds the Angiogenesis demo" {
    _require_installed "cc3d-player5"
    _require_installed "python3-compucell3d"
    run --separate-stderr bash -c "cc3d-demo --list"
    grep -q "Angiogenesis/Angiogenesis.cc3d" <<<"$output" \
        || { echo "cc3d-demo --list did not list Angiogenesis: $output $stderr"; false; }
}

# ---------------------------------------------------------------------------
# Functional: run the Angiogenesis simulation headlessly through the engine
# ---------------------------------------------------------------------------

@test "compucell3d (run): Angiogenesis simulation runs headless and writes VTK output" {
    _require_installed "compucell3d"
    _require_installed "python3-compucell3d"
    local work="${BATS_TEST_TMPDIR}/run"
    mkdir -p "$work"
    cp -r "${ANGIO}" "${work}/Angiogenesis"
    run --separate-stderr bash -c "
        cd '${work}'
        timeout 300 cc3d_runScript.sh -i '${work}/Angiogenesis/Angiogenesis.cc3d' \
            -o '${work}/out' -f 2000
    "
    [ "$status" -eq 0 ] || { echo "engine exit=$status"; echo "stdout(tail)=$(tail -20 <<<"$output")"; echo "stderr(tail)=$(tail -20 <<<"$stderr")"; false; }
    run --separate-stderr bash -c "ls '${work}'/out/LatticeData/Step_*.vtk 2>/dev/null | head -1"
    [ -n "$output" ] || { echo "no VTK output produced under ${work}/out"; false; }
}

# ---------------------------------------------------------------------------
# GUI startup smoke (opt-in via xvfb) — catches launch-time crashes/imports
# ---------------------------------------------------------------------------

@test "cc3d-twedit5 (gui): launches under Xvfb without crashing" {
    _require_installed "cc3d-twedit5"
    _require_xvfb
    # Launch, hold ~8s, then kill. A crash (ImportError etc.) exits non-zero
    # before the timeout; surviving to the timeout (124) is success.
    run --separate-stderr bash -c "
        export LIBGL_ALWAYS_SOFTWARE=1
        timeout --preserve-status -s TERM 8 xvfb-run -a cc3d-twedit5
    "
    if grep -qiE 'Traceback|ModuleNotFoundError|ImportError' <<<"$output$stderr"; then
        echo "twedit crashed on startup:"; tail -20 <<<"$output$stderr"; false
    fi
    # 124/143 = killed by timeout = stayed up. 0 = exited cleanly. Anything else
    # with a traceback already failed above.
    case "$status" in 124|143|0) : ;; *) echo "unexpected exit=$status"; tail -20 <<<"$output$stderr"; false ;; esac
}

@test "cc3d-player5 (regression): main() forces QT_QPA_PLATFORM=xcb when a display is present" {
    _require_installed "cc3d-player5"
    # Guards the Wayland fix: Qt must use xcb (X11) so it agrees with VTK's
    # X11/GLX render window, else the Player dies with X BadWindow. Xvfb CI is
    # X11 so it can't reproduce the Wayland crash; assert the default is present.
    run --separate-stderr bash -c "grep -q 'QT_QPA_PLATFORM' /usr/lib/python3.14/site-packages/cc3d/player5/__main__.py"
    [ "$status" -eq 0 ] || { echo "xcb default missing from player __main__ — Wayland BadWindow fix regressed"; false; }
}

@test "cc3d-player5 (gui): launches under Xvfb without crashing" {
    _require_installed "cc3d-player5"
    _require_xvfb
    run --separate-stderr bash -c "
        export LIBGL_ALWAYS_SOFTWARE=1
        timeout --preserve-status -s TERM 8 xvfb-run -a cc3d-player5
    "
    if grep -qiE 'Traceback|ModuleNotFoundError|ImportError' <<<"$output$stderr"; then
        echo "player crashed on startup:"; tail -20 <<<"$output$stderr"; false
    fi
    case "$status" in 124|143|0) : ;; *) echo "unexpected exit=$status"; tail -20 <<<"$output$stderr"; false ;; esac
}
