#!/usr/bin/env bats
# AUTOGENERATED from packages.tsv by generate-tests.sh — do not edit manually.
#
# Run with:
#   bats smoke.bats                  # serial, plain TAP
#   bats --jobs 8 smoke.bats         # parallel
#   bats -F tap smoke.bats           # explicit TAP formatter
#   bats -F junit -o results smoke.bats   # JUnit XML for CI

# We use `run --separate-stderr` which needs bats >= 1.5.0. Declaring the
# minimum suppresses the BW02 warning that otherwise fires on every test.
bats_require_minimum_version 1.5.0

setup_file() {
    export NEUROFEDORA_TESTS=1
}

# Skip the whole test if its package isn't installed (so a partial install
# doesn't produce a wall of "not installed" failures — only the install.sh
# reports those).
_require_installed() {
    local pkg="$1"
    rpm -q --quiet "$pkg" 2>/dev/null || skip "$pkg not installed"
}


@test "InsightToolkit5 (lib): test -f /usr/lib64/libITKCommon-5.4.so.1" {
    _require_installed "InsightToolkit5"
    run --separate-stderr bash -c "test -f /usr/lib64/libITKCommon-5.4.so.1"
    [ "$status" -eq 0 ] || { echo "exit=$status stdout=$output stderr=$stderr"; false; }
}

